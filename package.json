{
  "name": "sharm-tours-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run i18n:check -- --strict",
    "test:e2e": "playwright test",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
