# Public site URL (canonical links, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact details shown on the site (digits only for WhatsApp, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional — links are hidden when empty
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Base URL of licensed original photos. Leave empty to use placeholder photos.
NEXT_PUBLIC_IMAGE_BASE=

# Home hero background video (mp4). Default: public/videos/hero.mp4
NEXT_PUBLIC_HERO_VIDEO=
# /en/sharm/ hero video (falls back to NEXT_PUBLIC_HERO_VIDEO, then public/videos/hero.mp4)
NEXT_PUBLIC_SHARM_VIDEO=

# Server-only
DATA_DIR=.data
# Admin panel at /admin — leave empty to disable it
ADMIN_PASSWORD=
# Optional: separate key for signing admin session cookies (defaults to one derived from ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
# Bearer token for the JSON API (GET /api/bookings/, /api/contact/)
ADMIN_TOKEN=
# RATE_LIMIT=off
